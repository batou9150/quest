                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DropRequest": {
        "properties": {
          "itemName": {
            "type": "string",
            "title": "Itemname",
            "description": "The name of the item to drop from the inventory."
          }
        },
        "type": "object",
        "required": [
          "itemName"
        ],
        "title": "DropRequest"
      },
      "DropResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "A message describing the result of the drop."
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "DropResponse"
      },
      "ExamineRequest": {
        "properties": {
          "target": {
            "type": "string",
            "title": "Target",
            "description": "The name of the item or exit to examine."
          }
        },
        "type": "object",
        "required": [
          "target"
        ],
        "title": "ExamineRequest"
      },
      "ExamineResponse": {
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "description"
        ],
        "title": "ExamineResponse"
      },
      "FinalRoomResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "A message congratulating the player on completing the level."
          },
          "score": {
            "type": "integer",
            "title": "Score",
            "description": "The player's final score for the level."
          }
        },
        "type": "object",
        "required": [
          "message",
          "score"
        ],
        "title": "FinalRoomResponse"
      },
      "InventoryResponse": {
        "properties": {
          "inventory": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Inventory",
            "description": "The player's inventory."
          }
        },
        "type": "object",
        "required": [
          "inventory"
        ],
        "title": "InventoryResponse"
      },
      "MoveRequest": {
        "properties": {
          "exit": {
            "type": "string",
            "title": "Exit",
            "description": "The name of the exit to use."
          }
        },
        "type": "object",
        "required": [
          "exit"
        ],
        "title": "MoveRequest"
      },
      "Room": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Items",
            "default": []
          },
          "exits": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exits",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "title": "Room"
      },
      "TakeRequest": {
        "properties": {
          "itemName": {
            "type": "string",
            "title": "Itemname",
            "description": "The name of the item to take from the current room."
          }
        },
        "type": "object",
        "required": [
          "itemName"
        ],
        "title": "TakeRequest"
      },
      "TakeResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "A message confirming the result of the take action."
          },
          "item": {
            "type": "string",
            "title": "Item",
            "description": "The name of the item that was taken."
          }
        },
        "type": "object",
        "required": [
          "message",
          "item"
        ],
        "title": "TakeResponse"
      },
      "UseRequest": {
        "properties": {
          "direct_object": {
            "type": "string",
            "title": "Direct Object",
            "description": "The identifier of the direct object. An object can be an item in your inventory, an item in the room, or an exit."
          },
          "indirect_object": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Indirect Object",
            "description": "The identifier of the indirect object. If provided, the game attempts to use `direct_object` and `indirect_object` on each other."
          }
        },
        "type": "object",
        "required": [
          "direct_object"
        ],
        "title": "UseRequest"
      },
      "UseResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "A message describing the result of the use action."
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "UseResponse"
      },
      "GameError": {
        "type": "object",
        "title": "GameError",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code.",
            "enum": [
              "unknown_target",
              "unknown_exit",
              "locked",
              "not_takeable",
              "not_carrying",
              "level_finished",
              "no_active_level",
              "unauthenticated",
              "invalid_authorization",
              "invalid_api_key",
              "banned",
              "rate_limited",
              "invalid_request",
              "invalid_json"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation, safe to show to the player."
          }
        }
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Value: `ApiKey <your key>`"
      }
    }
  }
}