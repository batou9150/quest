{
  "openapi": "3.1.0",
  "info": {
    "title": "The Quantum Quest Game API",
    "version": "1.0.0",
    "description": "Play The Quantum Quest over HTTP. Every call acts on your *active level*: start one from Level Select on the website first. Authenticate with `Authorization: ApiKey <your key>` (get a key on the API Access page).\n\nexamine, move, take, drop and use count as actions; look and inventory are free. Finishing a level in more actions than its par lowers its score. Calls are limited per user per minute (see the X-RateLimit-* headers)."
  },
  "servers": [
    {
      "url": "/",
      "description": "This server"
    }
  ],
  "paths": {
    "/game/look": {
      "get": {
        "summary": "Look",
        "description": "Get the player's current location.\n\nReturns the current room, including its description, items, and exits.",
        "operationId": "look",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "400": {
            "description": "The active level is already finished (level_finished)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/game/inventory": {
      "get": {
        "summary": "Inventory",
        "description": "Get the player's current inventory.",
        "operationId": "inventory",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "400": {
            "description": "The active level is already finished (level_finished)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/game/examine": {
      "post": {
        "summary": "Examine",
        "description": "Allows the player to get a detailed description of an item or exit.",
        "operationId": "examine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamineResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or the action failed in the game (unknown target, locked exit, ...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/game/move": {
      "post": {
        "summary": "Move",
        "description": "Move through an exit of the current room (e.g. `north`; `n`, `s`, `e`, `w`, `u`, `d` work too).\n\nReturns the new room, or a `FinalRoomResponse` with your score when the exit completes the level.",
        "operationId": "move",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Room"
                    },
                    {
                      "$ref": "#/components/schemas/FinalRoomResponse"
                    }
                  ],
                  "title": "Response Move"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or the action failed in the game (unknown target, locked exit, ...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/game/take": {
      "post": {
        "summary": "Take",
        "description": "Take an item from the current room and add it to the player's inventory.",
        "operationId": "take",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
