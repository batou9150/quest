                  "$ref": "#/components/schemas/TakeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or the action failed in the game (unknown target, locked exit, ...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/game/use": {
      "post": {
        "summary": "Use",
        "description": "Use a thing, or two things on each other (`indirect_object`). Things can be items in your inventory, items in the room, or exits of the room.",
        "operationId": "use",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or the action failed in the game (unknown target, locked exit, ...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/game/drop": {
      "post": {
        "summary": "Drop",
        "description": "Drop an item from the player's inventory into the current room.",
        "operationId": "drop",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DropRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DropResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or the action failed in the game (unknown target, locked exit, ...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "409": {
            "description": "No active level: start one from Level Select",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header",
            "content": {
              "application/json": {
