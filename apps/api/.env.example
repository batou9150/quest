# Local development: in-memory store, no OAuth apps needed.
STORE=memory
DEV_LOGIN=true
PUBLIC_URL=http://localhost:5173
ADMIN_EMAILS=admin@dev.local

# To use the Firestore emulator instead: STORE=firestore and
# FIRESTORE_EMULATOR_HOST=localhost:8681 GOOGLE_CLOUD_PROJECT=demo-quest

# OAuth apps (optional locally). Callback URLs: $PUBLIC_URL/auth/google/callback, $PUBLIC_URL/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
